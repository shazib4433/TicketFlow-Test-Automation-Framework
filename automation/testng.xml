<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TicketFlow Suite" parallel="false">
    <listeners>
        <listener class-name="utils.TestExecutionListener"/>
    </listeners>
    <test name="API and UI Tests">
        <groups>
            <run>
                <include name="${groups}"/>
            </run>
        </groups>
        <packages>
            <package name="api"/>
            <package name="ui"/>
            <package name="integration"/>
            <package name="concurrency"/>
        </packages>
    </test>
</suite>
